{
  "name": "Generador Automático de Épicas y Tareas",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Generador de Épicas",
        "formDescription": "Ingresa el requerimiento del cliente",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Requerimiento",
              "fieldType": "textarea",
              "requiredField": true,
              "fieldId": "requerimiento"
            }
          ]
        },
        "options": {}
      },
      "id": "formulario-entrada",
      "name": "Formulario de Entrada",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "form-webhook"
    },
    {
      "parameters": {
        "model": "llama-3.1-70b-versatile",
        "options": {
          "systemMessage": "Sos un arquitecto de software. Tu tarea es analizar requerimientos de cliente y generar documentación estructurada.\n\nDado un requerimiento, genera un JSON con esta estructura exacta:\n\n{\n  \"titulo\": \"Título de la épica\",\n  \"descripcion\": \"Descripción detallada\",\n  \"userStories\": [\n    \"Como [usuario] quiero [funcionalidad] para [beneficio]\"\n  ],\n  \"consideracionesTecnicas\": [\n    \"Consideración técnica 1\",\n    \"Consideración técnica 2\"\n  ],\n  \"diagramaMermaid\": \"graph TD\\n    A[Inicio] --> B[Proceso]\\n    B --> C[Fin]\",\n  \"tareas\": [\n    {\n      \"titulo\": \"Título de la tarea\",\n      \"descripcion\": \"Descripción\",\n      \"tipo\": \"UI\" | \"API\" | \"Database\" | \"Testing\",\n      \"prioridad\": \"Alta\" | \"Media\" | \"Baja\"\n    }\n  ]\n}\n\nGenera SOLO el JSON, sin texto adicional."
        },
        "prompt": "={{ $json.requerimiento }}"
      },
      "id": "agente-ia",
      "name": "Agente IA (Groq)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [470, 300],
      "credentials": {
        "groqApi": {
          "id": "groq-credentials",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parsear el JSON de la respuesta de IA\nconst items = [];\n\nfor (const item of $input.all()) {\n  try {\n    let texto = item.json.text || item.json.response || item.json.output;\n    \n    // Limpiar el texto si viene con markdown\n    texto = texto.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    \n    // Parsear el JSON\n    const datos = JSON.parse(texto);\n    \n    items.push({\n      json: datos\n    });\n  } catch (error) {\n    throw new Error(`Error parseando JSON: ${error.message}`);\n  }\n}\n\nreturn items;"
      },
      "id": "parser-json",
      "name": "Parser JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "resource": "page",
        "databaseId": {
          "__rl": true,
          "value": "30ab86be733280dc9827e5bbd2929364",
